project_dir = /path/to/rl-course
data_dir = /path/to/large-storage/rl-course
campaign = rl-v2-full

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = $(project_dir)
executable = $(project_dir)/condor/run.sh
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir) VENV=$(data_dir)/venvs/rl-course-cpu OMP_NUM_THREADS=4"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

request_cpus = 4
request_memory = 8G
request_disk = 10G
request_gpus = 0

arguments = -m rl_course.racetrack --algorithm $(algorithm) --episodes $(episodes) --evaluation-interval $(evaluation_interval) --evaluation-episodes 100 --alpha $(alpha) --gamma 0.99 --epsilon-start 1.0 --epsilon-end 0.05 --epsilon-decay $(epsilon_decay) --seed $(seed) --output $(data_dir)/runs/$(campaign)/racetrack/$(algorithm)/seed-$(seed)
output = $(data_dir)/logs/racetrack-full.$(algorithm).$(seed).$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/racetrack-full.$(algorithm).$(seed).$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/racetrack-full.$(algorithm).$(seed).$(ClusterId).$(ProcId).log

queue algorithm, episodes, evaluation_interval, alpha, epsilon_decay, seed from (
    q-learning 300000 10000 0.05 0.99996 21
    q-learning 300000 10000 0.05 0.99996 42
    q-learning 300000 10000 0.05 0.99996 87
    online-dqn 300000 10000 0.05 0.99996 21
    online-dqn 300000 10000 0.05 0.99996 42
    online-dqn 300000 10000 0.05 0.99996 87
    replay-dqn 30000 1000 0.0005 0.9996 21
    replay-dqn 30000 1000 0.0005 0.9996 42
    replay-dqn 30000 1000 0.0005 0.9996 87
    dqn 20000 1000 0.0005 0.9996 21
    dqn 20000 1000 0.0005 0.9996 42
    dqn 20000 1000 0.0005 0.9996 87
)
