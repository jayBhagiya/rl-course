project_dir = /path/to/rl-course
data_dir = /path/to/large-storage/rl-course
campaign = rl-v1-pilot

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = /path/to/home
executable = $(project_dir)/condor/run.sh
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir) VENV=$(data_dir)/venvs/rl-course-cpu OMP_NUM_THREADS=4"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

request_cpus = 4
request_memory = 8G
request_disk = 10G
request_gpus = 0

arguments = -m rl_course.racetrack --algorithm random --episodes 1 --evaluation-interval 1 --evaluation-episodes 100 --seed $(seed) --output $(data_dir)/runs/$(campaign)/racetrack/random/seed-$(seed)
output = $(data_dir)/logs/racetrack.random.$(seed).$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/racetrack.random.$(seed).$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/racetrack.random.$(seed).$(ClusterId).$(ProcId).log
queue seed from (
    21
    42
    87
)

arguments = -m rl_course.racetrack --algorithm $(algorithm) --episodes 10000 --evaluation-interval 500 --evaluation-episodes 100 --seed $(seed) --output $(data_dir)/runs/$(campaign)/racetrack/$(algorithm)/seed-$(seed)
output = $(data_dir)/logs/racetrack.$(algorithm).$(seed).$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/racetrack.$(algorithm).$(seed).$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/racetrack.$(algorithm).$(seed).$(ClusterId).$(ProcId).log
queue algorithm, seed from (
    q-learning 21
    q-learning 42
    q-learning 87
    online-dqn 21
    online-dqn 42
    online-dqn 87
    replay-dqn 21
    replay-dqn 42
    replay-dqn 87
    dqn 21
    dqn 42
    dqn 87
)

