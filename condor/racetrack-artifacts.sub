project_dir = /path/to/rl-course
data_dir = /path/to/large-storage/rl-course
campaign = rl-artifacts

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = $(project_dir)
executable = $(project_dir)/condor/run.sh
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir) VENV=$(data_dir)/venvs/rl-course-cpu OMP_NUM_THREADS=4"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

request_cpus = 4
request_memory = 8G
request_disk = 10G
request_gpus = 0

arguments = -m rl_course.racetrack --algorithm dqn --episodes 20000 --evaluation-interval 1000 --evaluation-episodes 100 --alpha 0.0005 --gamma 0.99 --epsilon-start 1.0 --epsilon-end 0.05 --epsilon-decay 0.9996 --seed 87 --save-artifacts --output $(data_dir)/runs/$(campaign)/racetrack/dqn/seed-87
output = $(data_dir)/logs/racetrack-artifacts.dqn.seed-87.$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/racetrack-artifacts.dqn.seed-87.$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/racetrack-artifacts.dqn.seed-87.$(ClusterId).$(ProcId).log

queue 1
